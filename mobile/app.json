{
  "expo": {
    "name": "Sunnah Ilm",
    "slug": "sunnah-ilm",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#022A20"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sunnahilm.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#022A20",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sunnah-Ilm to access your photos for a profile image.",
          "cameraPermission": "Allow Sunnah-Ilm to take a profile photo."
        }
      ]
    ]
  }
}

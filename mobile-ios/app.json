{
  "expo": {
    "name": "Sunnah Ilm",
    "slug": "sunnah-ilm-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sunnahilm.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d3e1b64d-19c8-47dc-ba31-a3585ffb9c9e"
      }
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "mode": "development",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#022A20",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sunnah-Ilm to access your photos for a profile image.",
          "cameraPermission": "Allow Sunnah-Ilm to take a profile photo."
        }
      ]
    ],
    "owner": "sarim-sam"
  }
}
